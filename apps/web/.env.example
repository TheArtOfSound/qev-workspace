# Public build-time configuration only. Never put JWT secrets or DB credentials here.

# Development uses the Vite /api proxy when these are unset.
# Production builds require an absolute API/relay base URL.
VITE_API_URL=http://localhost:8787
VITE_AUTH_API_URL=http://localhost:8787
VITE_RELAY_URL=ws://localhost:8787/ws
VITE_ROOMS_URL=http://localhost:8787

# Optional: only for local experimentation. Production TURN secrets belong on the relay
# and are issued via GET /api/webrtc/ice — do not embed permanent TURN credentials.
# VITE_TURN_URL=
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
