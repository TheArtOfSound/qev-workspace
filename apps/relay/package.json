{
  "name": "@qev-workspace/relay",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--experimental-sqlite' tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node ./scripts/copy-migrations.mjs",
    "start": "node --experimental-sqlite dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:chat": "NODE_OPTIONS='--experimental-sqlite' node --import tsx --test src/mockChat.test.ts",
    "test:auth": "NODE_OPTIONS='--experimental-sqlite' node --import tsx --test src/auth/auth.integration.test.ts",
    "test:unit": "NODE_OPTIONS='--experimental-sqlite' node --import tsx --test src/**/*.test.ts src/**/**/*.test.ts",
    "seed:dev": "NODE_OPTIONS='--experimental-sqlite' node scripts/seed-dev-user.mjs",
    "migrate": "NODE_OPTIONS='--experimental-sqlite' tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.1",
    "@qev-workspace/protocol": "workspace:*",
    "fastify": "^5.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
