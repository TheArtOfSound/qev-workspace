# Relay / API
PORT=8787
NODE_ENV=development

# Storage: production must use durable SQLite (or a future Postgres DATABASE_URL).
# USE_MOCK_STORAGE=true enables the old in-memory room/chat/auth path (development only).
USE_MOCK_STORAGE=false
MOCK_AUTH_ENABLED=false
SQLITE_PATH=.data/qev-workspace.sqlite
# DATABASE_URL=file:.data/qev-workspace.sqlite
# DATABASE_URL=postgresql://user:pass@host:5432/qev  # not yet supported in this pass

# JWT access tokens (required in production, min 32 chars)
JWT_SIGNING_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=qev-workspace
JWT_AUDIENCE=qev-workspace-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# CORS / origins (comma-separated, no trailing slash)
WEB_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://theartofsound.github.io

# Ephemeral QEV pairing room invite TTL (screen-share lobby, not persistent rooms)
ROOM_TTL_MS=300000

# Optional TURN (server-issued temporary credentials preferred)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Limits
BODY_LIMIT_BYTES=65536
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
